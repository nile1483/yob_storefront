      ],
      "url": {
       "raw": "{{base_url}}/api/method/yob_storefront.api.catalog.get_items?scope_type=category&scope_value={{category_slug}}&storefront_filters={\"material\":[\"steel\"],\"finish\":[\"black\"]}&page_size=24",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "api",
        "method",
        "yob_storefront.api.catalog.get_items"
       ],
       "query": [
        {
         "key": "scope_type",
         "value": "category"
        },
        {
         "key": "scope_value",
         "value": "{{category_slug}}"
        },
        {
         "key": "storefront_filters",
         "value": "{\"material\":[\"steel\"],\"finish\":[\"black\"]}"
        },
        {
         "key": "page_size",
         "value": "24"
        }
       ]
      },
      "description": "AUTH\n\nOR within a filter, AND across filters. The selection is part of the cursor binding: reusing a cursor under a different selection answers cursor_invalid."
     }
    }
