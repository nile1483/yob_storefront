    {
     "name": "[AUTH] get_items (bounded listing)",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base_url}}/api/method/yob_storefront.api.catalog.get_items?scope_type=category&scope_value={{category_slug}}&page_size=24&sort=name_asc",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "api",
        "method",
        "yob_storefront.api.catalog.get_items"
       ],
       "query": [
        {
         "key": "scope_type",
         "value": "category"
        },
        {
         "key": "scope_value",
         "value": "{{category_slug}}"
        },
        {
         "key": "page_size",
         "value": "24"
        },
        {
         "key": "sort",
         "value": "name_asc"
        }
       ]
      },
      "description": "AUTH\n\nOne card per simple Item and one per variant FAMILY -- never one per variant. Read `price_state`: `priced` has money, `select_options` is a family and every monetary field is null."
     }
    },
    {
     "name": "[AUTH] get_item (simple OR family)",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base_url}}/api/method/yob_storefront.api.catalog.get_item?slug={{item_slug}}&qty=1",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "api",
        "method",
        "yob_storefront.api.catalog.get_item"
       ],
       "query": [
        {
         "key": "slug",
         "value": "{{item_slug}}"
        },
        {
         "key": "qty",
         "value": "1"
        }
       ]
      },
      "description": "AUTH\n\nDiscriminate on `data.is_template`: 0 = purchasable product, 1 = variant family carrying `attributes[]` + `variants[]` and NO price. Valid combinations come only from `variants[]`."
     }
    },
    {
     "name": "[AUTH] resolve_variant",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base_url}}/api/method/yob_storefront.api.catalog.resolve_variant?template={{template_item_code}}&attributes={\"Colour\":\"Orange\",\"Size\":\"Medium\"}&qty=1",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "api",
        "method",
        "yob_storefront.api.catalog.resolve_variant"
       ],
       "query": [
        {
         "key": "template",
         "value": "{{template_item_code}}"
        },
        {
         "key": "attributes",
         "value": "{\"Colour\":\"Orange\",\"Size\":\"Medium\"}"
        },
        {
         "key": "qty",
         "value": "1"
        }
       ]
      },
      "description": "AUTH\n\nA COMPLETE attribute selection -> the actual variant, priced. `attributes` is URL-encoded JSON containing every attribute of the family.\n\n422 `variant_attributes_required` when incomplete; 422 `variant_not_available` when the combination has no salable variant. Send `data.name` to add_to_cart."
     }
    },
    {
     "name": "[AUTH] get_category_filters",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base_url}}/api/method/yob_storefront.api.catalog.get_category_filters?scope_value={{category_slug}}",
       "host": [
