    {
     "name": "[AUTH] delete_address",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "X-Frappe-CSRF-Token",
        "value": "{{csrf_token}}"
       }
      ],
      "url": {
       "raw": "{{base_url}}/api/method/yob_storefront.api.address.delete_address",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "api",
        "method",
        "yob_storefront.api.address.delete_address"
       ],
       "query": []
      },
      "description": "AUTH\n\n200 deleted | 404 address_not_found | 409 address_in_use (Cart, historical Sales Order, or Customer default still references it). 409 is NOT retryable and detaches nothing. Never auto-retry a delete whose response was lost -- re-read the list.",
