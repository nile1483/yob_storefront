  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://storefront.local:8080"
    },
    {
      "key": "csrf_token",
      "value": "",
      "description": "From login response."
    },
    {
      "key": "payment_token",
      "value": "test_payment_token_example_only",
      "description": "From proceed_to_payment. A live bearer credential \u2014 never commit a real one."
    },
    {
      "key": "company",
      "value": "Example Trading Co"
    },
    {
      "key": "contact_name",
      "value": "Example Contact-Example Buyer Ltd"
    },
    {
      "key": "billing_address_name",
      "value": "Example Billing-Billing"
    },
    {
      "key": "shipping_address_name",
      "value": "Example Shipping-Shipping"
    },
