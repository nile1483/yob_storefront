{
 "info": {
  "name": "YOB Storefront API \u2014 frontend contract",
  "description": "Request names are prefixed [AUTH] or [PUBLIC].\n\nRun login_with_password first, keep the sid cookie, and put the returned csrf_token into {{csrf_token}}.\n\nNo real credentials, session ids, payment tokens or provider secrets are stored here \u2014 every such value is a placeholder.\n\nVariant flow: get_items (family card) -> get_item (family, attributes[] + variants[]) -> resolve_variant (actual SKU, priced) -> add_to_cart(item_code, qty).",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "variable": [
  {
   "key": "base_url",
   "value": "http://storefront.local:8080"
  },
  {
   "key": "csrf_token",
   "value": "",
   "description": "From login response."
  },
  {
   "key": "payment_token",
   "value": "test_payment_token_example_only",
   "description": "From proceed_to_payment. A live bearer credential \u2014 never commit a real one."
  },
  {
   "key": "company",
   "value": "Example Trading Co"
  },
  {
   "key": "contact_name",
   "value": "Example Contact-Example Buyer Ltd"
  },
  {
   "key": "billing_address_name",
   "value": "Example Billing-Billing"
  },
  {
   "key": "shipping_address_name",
   "value": "Example Shipping-Shipping"
  },
  {
   "key": "razorpay_order_id",
   "value": "order_EXAMPLE0001"
  },
  {
   "key": "razorpay_payment_id",
   "value": "pay_EXAMPLE0001"
  },
  {
   "key": "razorpay_signature",
   "value": "<from Razorpay callback>"
  },
  {
   "key": "order_id",
   "value": "SAL-ORD-2026-00001",
   "description": "a Sales Order id belonging to the logged-in customer"
  },
  {
   "key": "category_slug",
   "value": "fasteners"
  },
  {
   "key": "item_slug",
   "value": "cotton-tee"
  },
  {
   "key": "template_item_code",
   "value": "TEE"
  },
  {
   "key": "page_slug",
   "value": "about-us"
  }
 ],
