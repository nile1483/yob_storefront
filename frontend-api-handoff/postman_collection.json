         "value": "{{category_slug}}"
        }
       ]
      },
      "description": "AUTH\n\nFilters to display for this category, from its own Filter Set only. No counts. Use the returned keys in get_items?storefront_filters."
     }
    },
    {
     "name": "[AUTH] get_items (filtered)",
     "request": {
