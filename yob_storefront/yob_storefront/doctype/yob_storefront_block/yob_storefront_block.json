  },
  {
   "fieldname": "column_break_display",
   "fieldtype": "Column Break",
   "depends_on": "eval:[\"Image Banner\",\"Banner Carousel\",\"Promo Grid\"].includes(doc.block_type)"
  },
  {
   "fieldname": "mobile_height_px",
   "fieldtype": "Int",
   "label": "Mobile Height (px)",
   "depends_on": "eval:[\"Image Banner\",\"Banner Carousel\",\"Promo Grid\"].includes(doc.block_type)",
