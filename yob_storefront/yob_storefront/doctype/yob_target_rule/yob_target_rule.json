  },
  {
   "fieldname": "column_break_report",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "report_end_date",
   "fieldtype": "Date",
   "label": "Report End Date",
   "reqd": 1,
   "allow_on_submit": 1,
   "description": "Automatic recalculation stops after this date and the last result stands. INCLUSIVE."
  },
  {
