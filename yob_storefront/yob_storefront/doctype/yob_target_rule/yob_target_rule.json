   "label": "Enabled",
   "default": "1",
   "allow_on_submit": 1,
   "description": "Operational switch. Editable after submission."
  },
  {
   "fieldname": "customer_visible",
   "fieldtype": "Check",
   "label": "Customer Visible",
   "default": "0",
   "allow_on_submit": 1,
