   "description": "Required when Target Scope is Item."
  },
  {
   "fieldname": "scope_item_group",
   "fieldtype": "Link",
   "label": "Item Group",
   "options": "Item Group",
   "depends_on": "eval:doc.target_scope=='Item Group'",
